# =============================================================================
# CODE-ARENA MySQL Database Configuration Template
# Copy this file to 'db.properties' and fill in your local MySQL credentials.
# =============================================================================

# MySQL JDBC Host, Port and Database Name
db.host=localhost
db.port=3306
db.name=online_mcq_quiz

# JDBC Connection Parameters (Timezone, SSL, Public Key Retrieval)
db.params=useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Authentication Credentials
db.user=root
db.password=Pranav@mysql

# Optional Full JDBC URL override (if specified, overrides host/port/name above)
# db.url=jdbc:mysql://localhost:3306/online_mcq_quiz?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
